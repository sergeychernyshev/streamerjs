{
  "name": "@streamerjs/streamerjs",
  "version": "1.3.1",
  "description": "Video stream layout manager",
  "main": "./cli.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergeychernyshev/streamerjs"
  },
  "scripts": {
    "run": "node cli.js",
    "npm-publish": "npm publish --access=public",
    "dev": "npm link",
    "prod": "npm -g unlink @streamerjs/streamerjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only && npm run format",
    "release": "changeset publish"
  },
  "author": "Sergey Chernyshev",
  "license": "BSD-3-Clause",
  "type": "module",
  "bin": {
    "@streamerjs/streamerjs": "./cli.js"
  },
  "dependencies": {
    "connect-livereload": "^0.6.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-pouchdb": "^4.2.0",
    "livereload": "^0.9.3",
    "pouchdb": "^8.0.1",
    "serve-index": "^1.9.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "prettier": "3.9.8"
  }
}
